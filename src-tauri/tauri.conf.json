{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIHub Switch",
  "version": "1.1.18",
  "identifier": "fun.csmy.aihubmix-switch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self' 'sha256-ls27Lc1OytcVawXPVMplz6LyKz2i9KYAVBw3u79qyB4='; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/codex_zh/LICENSE",
      "resources/codex_zh/NOTICE.md",
      "resources/claude_zh/LICENSE",
      "resources/claude_zh/NOTICE.md",
      "resources/claude_zh/scripts/aihub_macos.py",
      "resources/claude_zh/scripts/patch_claude_zh_cn.py",
      "resources/claude_zh/scripts/install_windows.ps1",
      "resources/claude_zh/scripts/install_linux.sh",
      "resources/claude_zh/scripts/patch_linux_asar.py",
      "resources/claude_zh/resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "template": "wix/per-user-main.wxs"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ccswitch"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1QTc5RTNFMzVFM0FDOEUKUldTT3JPTTFQcDZudGFmTFpwcmlhejR0L1JuSGhVWXFlU2ZlSy92TnBZK3dwWEJ1MG82ZjRna0MK",
      "endpoints": [
        "https://dl.csmy.fun:23457/github-updates/gh-2dfe2a292f49bc85/latest-v2.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
