{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIHubMix Switch",
  "version": "1.0.0",
  "identifier": "fun.csmy.aihubmix-switch",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIHubMix Switch",
        "width": 1040,
        "height": 760,
        "minWidth": 840,
        "minHeight": 640,
        "backgroundColor": "#f7f8fa",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "一个 API Key，轻松接入你的编程智能体",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1QTc5RTNFMzVFM0FDOEUKUldTT3JPTTFQcDZudGFmTFpwcmlhejR0L1JuSGhVWXFlU2ZlSy92TnBZK3dwWEJ1MG82ZjRna0MK",
      "endpoints": ["https://dl.csmy.fun:23457/updates/aihubmix-switch/latest.json"],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
